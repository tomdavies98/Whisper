<UserControl x:Class="Whisper.Client.Views.ServerBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:Whisper.Client.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ServerBrowserViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24,8,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <ui:TextBlock FontTypography="Title" Text="Your servers" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Saved connections live on this machine. Passwords are encrypted for your Windows account." />
        </StackPanel>

        <!-- Saved profiles -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:ListView Grid.Row="0"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                <ui:ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ServerProfileViewModel}">
                        <StackPanel Margin="4,6">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption"
                                          Text="{Binding Summary}" />
                        </StackPanel>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                <ui:Button Command="{Binding AddProfileCommand}"
                           Content="Add"
                           Icon="{ui:SymbolIcon Add24}" />
                <ui:Button Margin="8,0,0,0"
                           Command="{Binding RemoveProfileCommand}"
                           Content="Remove"
                           Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <ui:Card Grid.Row="1" Grid.Column="1">
            <StackPanel IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBooleanConverter}}">
                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Server label" />
                <ui:TextBox Margin="0,0,0,12"
                            PlaceholderText="My friends' server"
                            Text="{Binding SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Address" />
                        <ui:TextBox PlaceholderText="192.168.1.20 or friend.example.com"
                                    Text="{Binding SelectedProfile.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" />
                        <ui:TextBox Text="{Binding SelectedProfile.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Your name" />
                <ui:TextBox Margin="0,0,0,12"
                            MaxLength="32"
                            PlaceholderText="The name others see"
                            Text="{Binding SelectedProfile.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                <ui:PasswordBox Margin="0,0,0,12"
                                Password="{Binding SelectedProfile.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Server password" />

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Remember password"
                              IsChecked="{Binding SelectedProfile.RememberPassword, Mode=TwoWay}" />
                    <CheckBox Margin="16,0,0,0"
                              Content="Server uses HTTPS"
                              IsChecked="{Binding SelectedProfile.UseTls, Mode=TwoWay}" />
                    <CheckBox Margin="16,0,0,0"
                              Content="Trust its self-signed certificate"
                              IsChecked="{Binding SelectedProfile.AllowSelfSignedCertificate, Mode=TwoWay}"
                              IsEnabled="{Binding SelectedProfile.UseTls}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Actions -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock Grid.Column="0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding StatusMessage}"
                          TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:ProgressRing Width="20"
                                 Height="20"
                                 Margin="0,0,12,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Margin="0,0,8,0" Command="{Binding SaveCommand}" Content="Save" />
                <ui:Button Appearance="Primary"
                           Command="{Binding ConnectCommand}"
                           Content="Connect"
                           Icon="{ui:SymbolIcon Play24}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
