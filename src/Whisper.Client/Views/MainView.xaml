<UserControl x:Class="Whisper.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Whisper.Shared.Contracts;assembly=Whisper.Shared"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:Whisper.Client.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Channels -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:TextBlock Margin="8,4,0,4"
                              FontTypography="BodyStrong"
                              Text="{Binding ServerName}" />

                <ui:TextBlock Margin="8,12,0,4"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="TEXT CHANNELS" />

                <ListBox Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding TextChannels}"
                         SelectedItem="{Binding SelectedTextChannel, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type contracts:ChannelInfo}">
                            <ui:TextBlock Text="{Binding Name, StringFormat=# {0}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:TextBlock Margin="8,16,0,4"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="VOICE CHANNELS" />

                <ItemsControl ItemsSource="{Binding VoiceChannels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:VoiceChannelViewModel}">
                            <Border Margin="0,2,8,6" CornerRadius="6" Padding="0,2,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJoined}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Left"
                                               Appearance="Transparent"
                                               Command="{Binding DataContext.JoinVoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding Channel}"
                                               Content="{Binding Name}"
                                               Icon="{ui:SymbolIcon Speaker224}" />

                                    <ItemsControl Margin="22,0,8,0" ItemsSource="{Binding Occupants}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:MemberViewModel}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0"
                                                             Width="8"
                                                             Height="8"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                                             Visibility="{Binding IsSpeaking, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <ui:TextBlock Grid.Column="1"
                                                                  VerticalAlignment="Center"
                                                                  Text="{Binding DisplayName}"
                                                                  TextTrimming="CharacterEllipsis" />

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <ui:SymbolIcon Margin="4,0,0,0"
                                                                       FontSize="14"
                                                                       Symbol="MicOff24"
                                                                       Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <ui:SymbolIcon Margin="4,0,0,0"
                                                                       FontSize="14"
                                                                       Symbol="SpeakerOff24"
                                                                       Visibility="{Binding IsDeafened, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button Margin="0,8,0,0"
                           HorizontalAlignment="Stretch"
                           Appearance="Secondary"
                           Command="{Binding LeaveVoiceCommand}"
                           Content="Leave voice"
                           Icon="{ui:SymbolIcon CallEnd24}"
                           Visibility="{Binding ActiveVoiceChannelId, Converter={StaticResource EmptyToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Chat -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Button Grid.Row="0"
                       Margin="0,4"
                       HorizontalAlignment="Center"
                       Appearance="Transparent"
                       Command="{Binding LoadOlderCommand}"
                       Content="Load earlier messages"
                       Visibility="{Binding HasMoreHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ScrollViewer x:Name="MessageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ChatMessageViewModel}">
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0" Orientation="Horizontal">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SenderName}" />
                                    <ui:TextBlock Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Text="{Binding TimeLabel}" />
                                </StackPanel>

                                <ui:TextBlock Grid.Column="1"
                                              Text="{Binding Content}"
                                              TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            MaxLength="2000"
                            PlaceholderText="Write a message"
                            Text="{Binding MessageDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:Button Grid.Column="1"
                           Margin="8,0,0,0"
                           Appearance="Primary"
                           Command="{Binding SendCommand}"
                           Content="Send" />
            </Grid>
        </Grid>

        <!-- Members -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="2"
                      Margin="0,0,12,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:TextBlock Margin="8,4,0,8"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="CONNECTED" />

                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:MemberViewModel}">
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="8"
                                         Height="8"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                         Visibility="{Binding IsSpeaking, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ui:TextBlock Grid.Column="1" Text="{Binding DisplayName}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="4,0,0,0"
                                                   Symbol="Speaker224"
                                                   Visibility="{Binding IsInVoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:SymbolIcon Margin="4,0,0,0"
                                                   Symbol="MicOff24"
                                                   Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:SymbolIcon Margin="4,0,0,0"
                                                   Symbol="SpeakerOff24"
                                                   Visibility="{Binding IsDeafened, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:ToggleSwitch Content="Mute"
                                     IsChecked="{Binding IsMuted, Mode=OneWay}"
                                     Command="{Binding ToggleMuteCommand}" />
                    <ui:ToggleSwitch Margin="16,0,0,0"
                                     Content="Deafen"
                                     IsChecked="{Binding IsDeafened, Mode=OneWay}"
                                     Command="{Binding ToggleDeafenCommand}" />
                </StackPanel>

                <ui:TextBlock Grid.Column="1"
                              Margin="16,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{Binding StatusMessage}"
                              TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Appearance="Secondary"
                               Command="{Binding OpenSettingsCommand}"
                               Content="Audio"
                               Icon="{ui:SymbolIcon Settings24}" />

                    <ui:Button Command="{Binding DisconnectCommand}"
                               Content="Disconnect"
                               Icon="{ui:SymbolIcon SignOut24}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
