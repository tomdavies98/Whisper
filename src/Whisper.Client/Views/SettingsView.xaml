<UserControl x:Class="Whisper.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:Whisper.Client.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Grid.Row="0"
                      Margin="0,0,0,16"
                      FontTypography="Title"
                      Text="Audio settings" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Microphone" />
                        <ComboBox Margin="0,0,0,12"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" />

                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Speakers or headset" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" />

                        <ui:Button Margin="0,12,0,0"
                                   Appearance="Transparent"
                                   Command="{Binding RefreshDevicesCommand}"
                                   Content="Refresh device list"
                                   Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Input level" />
                        <ProgressBar Height="8"
                                     Margin="0,0,0,12"
                                     Maximum="1"
                                     Minimum="0"
                                     Value="{Binding InputLevel, Mode=OneWay}" />

                        <ui:ToggleSwitch Margin="0,0,0,12"
                                         Content="Use push to talk (left control)"
                                         IsChecked="{Binding UsePushToTalk, Mode=TwoWay}" />

                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}"
                                      Text="Voice activation threshold (dBFS)" />
                        <Slider Margin="0,0,0,4"
                                IsEnabled="{Binding UsePushToTalk, Converter={StaticResource InverseBooleanConverter}}"
                                Maximum="-20"
                                Minimum="-70"
                                TickFrequency="1"
                                Value="{Binding VoiceActivityThresholdDb, Mode=TwoWay}" />
                        <ui:TextBlock Margin="0,0,0,12"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding VoiceActivityThresholdDb, StringFormat={}{0:0} dBFS}" />

                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Input gain" />
                        <Slider Maximum="3"
                                Minimum="0.2"
                                Value="{Binding InputGain, Mode=TwoWay}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource FieldLabelStyle}" Text="Jitter buffer" />
                        <Slider Maximum="10"
                                Minimum="1"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding JitterBufferFrames, Mode=TwoWay}" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding JitterBufferLabel, StringFormat=Adds {0} of delay. Raise it if audio breaks up.}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock Grid.Column="0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding StatusMessage}"
                          TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding ApplyCommand}" Content="Apply" />
                <ui:Button Appearance="Primary"
                           Command="{Binding CloseCommand}"
                           Content="Done" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
