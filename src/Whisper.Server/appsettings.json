{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Whisper": {
    "ServerName": "Whisper Server",
    "HubPort": 5000,
    "VoicePort": 5001,
    "DataDirectory": "data",
    "MaxMembers": 64,
    "ChatRateLimitBurst": 10,
    "ChatRateLimitWindowSeconds": 5,
    "AuthRateLimitBurst": 5,
    "AuthRateLimitWindowSeconds": 30,
    "ActionRateLimitBurst": 30,
    "ActionRateLimitWindowSeconds": 10,
    "VoicePacketsPerSecond": 100
  }
}
